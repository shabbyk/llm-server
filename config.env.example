# Configuration for the local LLM server (Ollama). Sourced by every script, so
# it is plain shell — no quotes needed unless a value contains spaces.
#
# Precedence: built-in defaults  <  this file  <  environment variables.
# So `LLM_MODEL=qwen3.5:27b llm on` overrides whatever is set here.
#
# That precedence is why every assignment below uses ${VAR:=default} rather
# than VAR=default. A bare assignment would overwrite a value that was already
# set in the environment, which silently makes this file unbeatable. If you add
# a setting here, use the same form.
#
# After editing, restart for changes to take effect:
#     llm restart

# ------------------------------------------------------------------ model --
# An Ollama tag, not a path. `llm models` lists what is installed locally.
# Sizes on the RX 6600 (8 GB): 9b ≈ 5.7 GB, 27b will not fit.
: "${LLM_MODEL:=qwen3.5:9b}"

# ---------------------------------------------------------------- network --
# Address the server binds. Defaults to the detected LAN address, because this
# server has no API key and that is how the repository has always exposed it.
# Use 127.0.0.1 for tunnel-only access. Do not use 0.0.0.0 unless you mean to
# expose it to anything that can route here.
#: "${LLM_HOST:=127.0.0.1}"
: "${LLM_PORT:=11434}"

# -------------------------------------------------------------- behaviour --
# Context window. This is the most important setting on this page.
#
# Ollama's own default is 4096, and it does not warn you — it silently
# truncates. An agentic client's system prompt and tool definitions alone run
# ~6.6k tokens, so at 4096 the model appears to ignore instructions and forget
# context. 32768 is the default here for that reason.
#
# KV cache costs roughly the same regardless of backend; measured to load at
# 16384 and 32768 on an 8 GB card with the 9B Q4 model.
: "${LLM_CTX:=32768}"

# How long a model stays resident in VRAM after the last request. "0" unloads
# immediately; "-1" keeps it forever. Deliberately short by default so the GPU
# is not held when you are done — `llm off` is the explicit way to release it.
: "${LLM_KEEP_ALIVE:=5m}"

# ---------------------------------------------------------------- runtime --
# Where the installer put Ollama. User-local on purpose: no sudo, and no
# systemd unit that would start on boot.
#: "${OLLAMA_BIN:=$HOME/.local/bin/ollama}"
#: "${OLLAMA_MODELS_DIR:=$HOME/.ollama/models}"
