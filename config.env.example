# Configuration for the local LLM server. Sourced by every script, so it is plain
# shell — no quotes needed unless a value contains spaces.
#
# Precedence: built-in defaults  <  this file  <  environment variables.
# So `LLM_ENGINE=llamacpp llm on` overrides whatever is set here.
#
# That precedence is why every assignment below uses ${VAR:=default} rather
# than VAR=default. A bare assignment would overwrite a value that was already
# set in the environment, which silently makes this file unbeatable. If you add
# a setting here, use the same form.
#
# After editing, restart for changes to take effect:
#     llm restart

# ----------------------------------------------------------------- engine --
# Which runtime `llm on` starts. Both may be installed at the same time, on
# different ports; only one runs at once, so switching is just `llm restart`.
#
#   ollama     A model referenced by tag. `llm models` and `llm pull` manage it.
#              Default port 11434.
#
#   llamacpp   llama-server run against a GGUF file, with the bundled llama.ui
#              chat page served on the same port. Supports MCP tool servers, so
#              it can reach the RAG service. Default port 8090.
#
# Both speak the OpenAI API, so ask.sh and any client keep working either way.
: "${LLM_ENGINE:=ollama}"

# ------------------------------------------------------------------ model --
# Ollama identifies a model by tag; llama.cpp by the path to a GGUF file. Both
# are kept, so switching engines does not lose the other's setting.
#
# Sizes on the RX 6600 (8 GB): 9b ≈ 5.7 GB, 27b will not fit.
: "${LLM_MODEL:=qwen3.5:9b}"
: "${LLM_GGUF:=$HOME/llm/models/Qwen3.5-9B-Q4_K_M.gguf}"

# ---------------------------------------------------------------- network --
# Address the server binds. 127.0.0.1 means this machine only, which is the
# default because neither server has an API key.
#
# To serve other machines set LLM_HOST=0.0.0.0 (everything that can route here),
# and remember there is no authentication. Note that the Ollama CLI talks to
# 127.0.0.1:11434 unless told otherwise, so binding elsewhere makes `ollama list`
# print a spurious "could not connect" warning.
#: "${LLM_HOST:=127.0.0.1}"

# Left unset on purpose: each engine has its own default (ollama 11434,
# llamacpp 8090) and pinning one here would apply it to both. Set it only if you
# need a specific port, and remember it then applies whichever engine is active.
#: "${LLM_PORT:=11434}"

# -------------------------------------------------------------- behaviour --
# Context window. This is the most important setting on this page.
#
# Ollama's own default is 4096, and it does not warn you — it silently
# truncates. An agentic client's system prompt and tool definitions alone run
# ~6.6k tokens, so at 4096 the model appears to ignore instructions and forget
# context. 32768 is the default here for that reason.
#
# KV cache costs roughly the same regardless of backend; measured to load at
# 16384 and 32768 on an 8 GB card with the 9B Q4 model.
: "${LLM_CTX:=32768}"

# How long a model stays resident in VRAM after the last request (Ollama only).
# "0" unloads immediately; "-1" keeps it forever.
#
# The short default is a deliberate trade: it releases the GPU when you walk
# away, at the cost of re-reading 6 GB off disk the next time you speak. If the
# pause before the first token bothers you, "-1" removes it — `llm off` is still
# the explicit way to release the card.
#
# llama.cpp ignores this; it holds the weights until the process exits.
: "${LLM_KEEP_ALIVE:=5m}"

# ------------------------------------------------------- llama.cpp runtime --
# Layers to offload to the GPU. 99 means "all of them" and llama.cpp clamps it to
# the model. This is the setting that decides whether you get a 37 tok/s GPU
# decode or a single-digit CPU crawl, so `llm on` reads the actual offload back
# out of the log rather than trusting this number.
: "${LLM_NGL:=99}"

# Flash attention. Measured on this box to make no measurable difference to
# Ollama's prefill (8889 vs 8754 tok/s), so it is off until it earns its place.
: "${LLM_FA:=0}"

# Whether a reasoning model may think before answering.
#
# Qwen3.5 is one. Left alone it can put the whole answer in the reasoning channel
# and return an empty content field, which the UI renders as a blank reply. Off
# by default for that reason; ask.py sends `think: false` to Ollama for the same
# purpose.
: "${LLM_THINKING:=0}"

# The name llama.cpp advertises over /v1, so clients that ask for "qwen3.5:9b"
# keep working when the engine underneath changes.
#: "${LLM_ALIAS:=qwen3.5:9b}"

# Extra flags appended verbatim to the llama-server command line. A string, and
# it is word-split, so quoting inside it is not needed:
#   : "${LLM_EXTRA_ARGS:=--cache-type-k q8_0 --cache-type-v q8_0}"
: "${LLM_EXTRA_ARGS:=}"

# ---------------------------------------------------------------- tools --
# MCP tool servers, in the form llama-server expects.
#
#   rag on      sets this for you, and restarts the model
#   rag off     unsets it again
#
# llama.cpp only accepts MCP servers over stdio: it spawns the program itself,
# talks JSON-RPC over the pipes, and stops it afterwards. So there is no URL here
# and no service to run — just a command to launch. An entry with a "url" instead
# of a "command" is skipped with a warning in the log, which is the trap this
# avoids.
#
# This is the one setting NOT written as ${LLM_MCP:=...}, and that is not a style
# choice. A JSON value contains braces, and bash ends a ${...} expansion at the
# first unescaped }, so `: "${LLM_MCP:='{\"a\":1}'}"` silently yields a truncated
# and quote-stripped string. The guard below checks the environment first, which
# is the property the := form was there to provide.
#
# Leaving it unset means the model has no tools. That is the default because a
# tool-capable server is a reachable one: the model chooses what to fetch, and it
# can be talked into fetching something by a page it has already read.
[ -n "${LLM_MCP:-}" ] || LLM_MCP=''
