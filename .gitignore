# Runtime state, never commit these.
models/
logs/
llama-b*/
*.gguf
*.log

# TTS runtime tree. By default it lives outside the repo at ~/tts, but point
# TTS_DIR at tts/ and these rules keep the heavy and private parts untracked.
# voices/ in particular holds your own voice recordings — do not commit those.
tts/bin/
tts/voices/
tts/out/

# Local configuration (may hold a LAN IP or a token).
config.env

# Scratch
*.tmp
*.part
.DS_Store
__pycache__/
*.pyc

# Rust build output.
target/

# Open WebUI writes its session secret relative to the process CWD. The switch
# now runs it from its data dir, but ignore these anyway so a future slip
# cannot be committed.
.webui_secret_key
webui.db
