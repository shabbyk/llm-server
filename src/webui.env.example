# Open WebUI settings. Copied to ~/.openwebui/config.env by the installer, and
# sourced with `set -a`, so anything set here is exported to the server process.
#
# Precedence: built-in defaults < this file < environment variables at start.
#
# After editing, restart for changes to take effect:
#     webui restart

# ------------------------------------------------------------------ server --
: "${WEBUI_PORT:=8080}"
# Bound to the LAN because the point of a web UI is opening it from a browser.
# Open WebUI has its own login; the first account to sign up becomes admin.
# Set 127.0.0.1 for tunnel-only.
: "${WEBUI_HOST:=0.0.0.0}"

#: "${WEBUI_DIR:=$HOME/.openwebui}"
#: "${WEBUI_VENV:=$HOME/.venvs/openwebui}"

# ------------------------------------------------------------- speech (TTS) --
# Wired automatically to the local TTS server on 8081. Speech output in the UI
# reads answers aloud with a cloned voice once `tts on` is running.
: "${AUDIO_TTS_ENGINE:=openai}"
: "${AUDIO_TTS_MODEL:=tts-1}"
# Any advertised voice name works; `tts voices` lists them. A cloned voice is
# only present in that list once it has been uploaded.
: "${AUDIO_TTS_VOICE:=kobo}"

# ------------------------------------------------------ web search (opt-in) --
# OFF by default, and deliberately so.
#
# Open WebUI does not provide web search. It calls out to a search backend you
# have to supply. Nothing is enabled here until you choose one.
#
# The variable names matter: older documentation uses ENABLE_RAG_WEB_SEARCH and
# RAG_WEB_SEARCH_ENGINE, which this version ignores. Setting them looks correct
# and does nothing. The names below are the ones that work.
#
# DuckDuckGo needs no account and no key — the best starting point. This build
# also bundles searxng, brave, google_pse, tavily, exa, mojeek and about
# twenty-five others, each with its own RAG_* settings.
#
#   ENABLE_WEB_SEARCH=true
#   WEB_SEARCH_ENGINE=duckduckgo
#
# Or a hosted API (needs a key, and sends your queries to someone else):
#
#   ENABLE_WEB_SEARCH=true
#   WEB_SEARCH_ENGINE=brave
#   BRAVE_SEARCH_API_KEY=your-key-here
#
# Or a self-hosted SearXNG, if you have Docker (this machine does not):
#
#   ENABLE_WEB_SEARCH=true
#   WEB_SEARCH_ENGINE=searxng
#   SEARXNG_QUERY_URL=http://127.0.0.1:8888/search?q=<query>
#
# Leave all of the above commented out and the search controls stay hidden.
