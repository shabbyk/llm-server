#!/usr/bin/env bash
# On/off switch for the local LLM server.
#
#   llm              # same as "llm status"
#   llm on           # start  (Q6_K on the configured port)
#   llm on q4        # start  (Q4_K_M instead)
#   llm on q6 9090   # start  (different port)
#   llm off          # stop, and confirm GPU memory was released
#   llm toggle       # flip: off if running, on if not
#   llm toggle q4    # flip, starting with q4 if it was off
#   llm restart [q6|q4] [port]
#   llm status       # state, GPU memory, health
#   llm log          # tail the current log
#   llm watch        # attach to the tmux session (Ctrl-b d to detach)
#   llm help         # this list
#
# Nothing here starts automatically. After a reboot it stays off until you say
# "llm on". That is deliberate: it is a switch, not a service.

set -uo pipefail
# shellcheck disable=SC1091
. "${LLM_DIR:-$HOME/llm}/common.sh"

die() { echo "llm: $*" >&2; exit 2; }

# Is a server actually up? Ask the process, not tmux: a tmux session can outlive
# the server if it was killed by hand, and pgrep -f would match this script.
is_running() { pgrep -x llama-server >/dev/null; }

# The preset currently in use, read back from the live process's argv.
current_preset() {
    local pid args
    pid="$(pgrep -x llama-server | head -1)" || return 1
    [ -n "$pid" ] || return 1
    args="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" || return 1
    case "$args" in
        *Q6_K*)   echo q6 ;;
        *Q4_K_M*) echo q4 ;;
        *)        echo "?" ;;
    esac
}

gpu_counters() {
    local d
    d="$(llm_drm_device_dir 2>/dev/null)" || { echo "  (no DRM device with memory counters)"; return; }
    local vram gtt
    vram="$(cat "$d/mem_info_vram_used" 2>/dev/null || echo 0)"
    gtt="$(cat "$d/mem_info_gtt_used" 2>/dev/null || echo 0)"
    printf '  VRAM %s MB' "$(( vram / 1000000 ))"
    [ -r "$d/mem_info_gtt_used" ] && printf '   GTT %s MB' "$(( gtt / 1000000 ))"
    printf '\n'
}

do_status() {
    if is_running; then
        echo "llm    ON   preset $(current_preset)   pid $(pgrep -x llama-server | tr '\n' ' ')"
    else
        echo "llm    OFF"
    fi

    "$LLM_DIR/status.sh"

    if is_running; then
        echo "  url      http://$LLM_HOST:$LLM_PORT"
        echo "  ask      $LLM_DIR/ask.sh \"your question\""
    fi
}

do_on() {
    local preset="${1:-q6}" port="${2:-$LLM_PORT}"

    if is_running; then
        echo "llm: already ON (preset $(current_preset), pid $(pgrep -x llama-server | tr '\n' ' '))." >&2
        echo "llm: use 'llm off' first if you meant to restart." >&2
        return 1
    fi

    if ! command -v tmux >/dev/null 2>&1; then
        echo "llm: tmux is not installed, and the server needs it to survive your shell." >&2
        echo "llm: install it, or set LLM_SESSION= to use another supervisor." >&2
        return 1
    fi

    if [ ! -f "$(llm_model_path "$preset" 2>/dev/null || echo /nonexistent)" ]; then
        echo "llm: model for preset '$preset' is not downloaded yet." >&2
        echo "llm: run the installer, or fetch it (see README)." >&2
        return 1
    fi

    # A leftover tmux session with no server in it is a dead pane. Clear it
    # before starting so we never attach to nothing.
    if tmux has-session -t "$LLM_SESSION" 2>/dev/null; then
        tmux kill-session -t "$LLM_SESSION" 2>/dev/null || true
    fi

    "$LLM_DIR/up.sh" "$preset" "$port" || return 1

    # up.sh returns as soon as tmux has the session; the model is still loading.
    # Poll /health so "llm on" means "ready", not "process spawned".
    #
    # Liveness is judged by the tmux session, NOT by pgrep -x llama-server.
    # The start chain is bash -> start.sh -> llm-run -> newgrp -> llama-server,
    # so for the first ~100 ms there is no process named llama-server at all.
    # Treating that gap as failure makes "llm on" abort in under 100 ms while
    # the server is starting perfectly well.
    printf '  loading %s' "$preset"
    local code ready=0
    for _ in $(seq 1 120); do
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
                "http://$LLM_HOST:$port/health" 2>/dev/null)"
        if [ "$code" = "200" ]; then ready=1; break; fi
        if ! tmux has-session -t "$LLM_SESSION" 2>/dev/null; then
            printf ' FAILED\n'
            echo "llm: the server exited during load. Check $LLM_LOGS/${preset}-p${port}.log" >&2
            return 1
        fi
        printf '.'
        sleep 1
    done

    if [ "$ready" -ne 1 ]; then
        printf ' TIMEOUT\n'
        echo "llm: no health response after 120s. Check $LLM_LOGS/${preset}-p${port}.log" >&2
        return 1
    fi
    printf ' ready\n'
    return 0
}

do_off() {
    local was=""
    is_running && was="$(current_preset)"

    "$LLM_DIR/down.sh" || return 1

    if is_running; then
        echo "llm: still running after down.sh" >&2
        return 1
    fi
    # Report the release rather than assume it: this is the step where a silent
    # failure would leave the GPU occupied with nothing using it.
    printf '  GPU memory released: '
    gpu_counters | sed 's/^  //'
    [ -n "$was" ] && echo "  was serving: $was"
    return 0
}

# Print the header comment block only, minus the leading "# ".
usage() { sed -n '2,/^$/p' "$0" | sed -e 's/^#\{1,\} \{0,1\}//' -e '/^$/d'; }

cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
    on|start|up)   do_on "${1:-q6}" "${2:-$LLM_PORT}" ;;
    off|stop|down) do_off ;;
    toggle)        if is_running; then do_off; else do_on "${1:-q6}" "${2:-$LLM_PORT}"; fi ;;
    restart)       do_off && do_on "${1:-q6}" "${2:-$LLM_PORT}" ;;
    status|"")     do_status ;;
    log)           preset="$(current_preset)"; [ -n "${preset:-}" ] && [ "$preset" != "?" ] || preset=q6
                   exec tail -f "$LLM_LOGS/${preset}-p${LLM_PORT}.log" ;;
    watch|attach)  exec tmux attach -t "$LLM_SESSION" ;;
    help|-h|--help) usage ;;
    *)             die "unknown command '$cmd' (try: llm help)" ;;
esac
