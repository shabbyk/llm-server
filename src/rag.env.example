# RAG settings. Copied to ~/rag/config.env by the installer, and sourced by the
# `rag` switch, so it is plain shell.
#
# Precedence: built-in defaults < this file < environment variables.
#
# There is no service to restart. llama.cpp spawns the retrieval server itself
# for each tool call, so after editing this file, re-attach it with `rag on` to
# pick up the change.

# ----------------------------------------------------------------- server --
# Only used by the opt-in HTTP transport (`rag serve`), for clients that want a
# URL rather than a spawned child. llama.cpp does not use this: it spawns the
# server over stdio, so nothing listens on this port in ordinary use.
: "${RAG_PORT:=8082}"

# Loopback by default. The service fetches whatever URL it is asked to, so it is
# not something to expose; attach it over a tunnel if you need it remotely.
#: "${RAG_HOST:=127.0.0.1}"

# ---------------------------------------------------------------- documents --
# Where `search_docs` looks. Markdown, text, CSV, JSON, RST and log files are
# read; anything larger than 2 MB is skipped. Add files and they are picked up on
# the next query — there is no index to rebuild.
: "${RAG_DOCS:=$HOME/rag/docs}"

# ----------------------------------------------------------------- venv --
#: "${RAG_VENV:=$HOME/.venvs/rag}"

# --------------------------------------------------------------- retrieval --
# How many characters per indexed chunk, and how much consecutive chunks overlap.
# Larger chunks keep more context per hit; smaller ones rank more precisely.
: "${RAG_CHUNK_SIZE:=900}"
: "${RAG_CHUNK_OVERLAP:=200}"

# Hard ceiling on how many search results a single call may request.
: "${RAG_MAX_RESULTS:=8}"

# Seconds before a page fetch is abandoned. Searches against slow hosts are
# common; a short timeout just means those pages are reported as failures.
: "${RAG_FETCH_TIMEOUT:=15}"
