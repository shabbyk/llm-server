# Configuration for the local TTS server. Sourced by common.sh, and therefore by
# every script in this directory. Plain shell — no quotes needed unless a value
# contains spaces.
#
# Precedence: built-in defaults  <  this file  <  environment variables.
# So `TTS_BACKEND=cpu tts on` overrides whatever is set here. That precedence is
# why every assignment uses ${VAR:=default} rather than VAR=default: a bare
# assignment would overwrite a value already in the environment, which makes
# this file unbeatable. Use the same form for anything you add here.
#
# Create this as $TTS_DIR/config.env (default ~/tts/config.env) and restart:
#     tts restart
#
# This file holds no secrets, but the runtime tree it points at holds your
# reference recordings. Nothing under $TTS_DIR is committed.

# ------------------------------------------------------------------- paths --
# The runtime tree: koboldcpp binary, model weights, voices/, logs/, out/.
# Source lives in the repo and is not affected by this.
: "${TTS_DIR:=$HOME/tts}"

# Normally derived from TTS_DIR. Override only to move one of them, e.g. to keep
# reference clips on a different disk.
#: "${TTS_BIN:=$TTS_DIR/bin/koboldcpp}"
#: "${TTS_MODELS:=$TTS_DIR/models}"
#: "${TTS_LOGS:=$TTS_DIR/logs}"
#: "${TTS_VOICES:=$TTS_DIR/voices}"
#: "${TTS_OUT:=$TTS_DIR/out}"

# ---------------------------------------------------------------- network --
# KoboldCpp speaks the OpenAI audio API here.
: "${TTS_PORT:=5001}"

# Web UI. The UI binds 0.0.0.0 and has NO AUTHENTICATION: anyone who can reach
# the port can upload files into the voices directory and restart the TTS
# server. Use 127.0.0.1 to reach it only through an SSH tunnel.
: "${TTS_WEBUI_PORT:=8081}"
: "${TTS_WEBUI_HOST:=0.0.0.0}"

# ----------------------------------------------------------------- backend --
# cpu | gpu. "gpu" means Vulkan, which is what an AMD card can use; KoboldCpp has
# no ROCm path. Measured on an RX 6600: Vulkan RTF 0.82 vs CPU 1.78, so ~2.2x.
# Set cpu if the GPU path misbehaves; it is slower than realtime but reliable.
: "${TTS_BACKEND:=gpu}"

# CPU threads. Generation is partly memory-bandwidth-bound, so going past the
# physical core count (6 here) rarely helps and can hurt.
: "${TTS_THREADS:=6}"

# Longest input accepted in one request, in tokens. Also the server-side cap.
: "${TTS_MAXLEN:=4096}"

# tmux session names, so you can run a second instance side by side.
: "${TTS_SESSION:=tts}"
: "${TTS_SHIM_PORT:=5002}"
: "${TTS_WEBUI_SESSION:=ttsui}"

# ------------------------------------------------------------------ models --
# 1.7b | 0.6b | auto. "auto" prefers the 1.7B when its GGUF is present. The 1.7B
# costs only ~11% more wallclock than the 0.6B on the GPU, because the codec
# Predictor dominates runtime and is the same size in both, so the bigger talker
# is close to free. Reach for 0.6b if VRAM is tight.
: "${TTS_MODEL:=auto}"
#: "${TTS_MODEL_REPO:=Qwen/Qwen3-TTS-12Hz-1.7B-Base-GGUF}"

# ------------------------------------------------------------------ web UI --
# Python that runs webui.py. It needs fastapi, uvicorn, httpx and
# python-multipart. The Open WebUI virtualenv has all four, which is why that is
# the default; point this at your own venv to stop depending on it.
: "${TTS_WEBUI_PYTHON:=$HOME/.venvs/ttsui/bin/python}"