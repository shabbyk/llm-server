# Configuration for the TTS server. Plain KEY=VALUE; copied to this path by the
# installer. `#` starts a comment.
#
# Precedence: built-in defaults < this file < environment variables.
# So `TTS_BACKEND=cpu tts on` overrides whatever is set here.
#
# After editing, restart for changes to take effect:
#     tts restart

# ------------------------------------------------------------------- paths --
# The runtime tree: the koboldcpp binary, model weights, voices, logs, output.
# Source lives in the repo and is not affected by this.
: "${TTS_DIR:=$HOME/tts}"
#: "${TTS_BIN:=$TTS_DIR/bin/koboldcpp}"
#: "${TTS_MODELS:=$TTS_DIR/models}"
#: "${TTS_LOGS:=$TTS_DIR/logs}"
#: "${TTS_VOICES:=$TTS_DIR/voices}"
#: "${TTS_OUT:=$TTS_DIR/out}"

# ---------------------------------------------------------------- network --
# The engine's OpenAI-shaped audio API.
: "${TTS_PORT:=5001}"

# Web UI. It binds 0.0.0.0 and has NO AUTHENTICATION: anyone who can reach the
# port can upload files into the voices directory and restart the TTS server.
# Set TTS_WEBUI_HOST=127.0.0.1 to reach it only through an SSH tunnel.
: "${TTS_WEBUI_PORT:=8081}"
: "${TTS_WEBUI_HOST:=0.0.0.0}"

# ----------------------------------------------------------------- backend --
# cpu | gpu. "gpu" means Vulkan — KoboldCpp has no ROCm path, and the RX 6600 is
# not ROCm-supported anyway. Measured RTF 0.82 on Vulkan against 1.78 on CPU.
# Set cpu if the GPU path misbehaves; it is slower than realtime but reliable.
: "${TTS_BACKEND:=gpu}"

# CPU threads. Generation is partly memory-bandwidth-bound, so going past the
# physical core count rarely helps and can hurt.
: "${TTS_THREADS:=6}"

# Longest input accepted in one request, in tokens. Also the server-side cap.
: "${TTS_MAXLEN:=4096}"

# ------------------------------------------------------------------ models --
# auto | 1.7b | 0.6b. "auto" prefers the 1.7B when its GGUF is present. The 1.7B
# costs only ~11% more wallclock than the 0.6B on the GPU, because the codec
# Predictor dominates runtime and is the same size in both.
: "${TTS_MODEL:=auto}"
